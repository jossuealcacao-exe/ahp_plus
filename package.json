{
  "name": "@jossuealcala/ahp-plus",
  "version": "1.4.0",
  "private": false,
  "description": "Git-backed governance, continuity, evidence, and handoff protocol for AI agents",
  "type": "module",
  "bin": {
    "ahp": "bin/ahp.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "templates",
    "docs",
    "SPECIFICATION.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "VERSION",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
