{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ahp-plus:schema:checkpoint:1.4.0",
  "title": "AHP+ Session Checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "session_id",
    "project_id",
    "summary",
    "next_action",
    "actor",
    "git",
    "created_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0"] },
    "id": { "type": "string", "pattern": "^CHK-[0-9]{8}-[A-F0-9]{8}$" },
    "kind": { "const": "checkpoint" },
    "session_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "objective": { "type": "string" },
    "next_action": { "type": "string" },
    "files": { "type": "array", "items": { "type": "string" } },
    "validations": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "actor": { "type": "object", "required": ["name", "platform", "model"] },
    "git": { "type": "object", "required": ["branch", "commit", "working_tree", "working_tree_digest", "project_working_tree", "project_working_tree_digest", "ahp_state_working_tree"] },
    "created_at": { "type": "string", "format": "date-time" },
    "integrity": { "type": "object", "required": ["algorithm", "canonicalization", "digest"] }
  },
  "additionalProperties": true
}
