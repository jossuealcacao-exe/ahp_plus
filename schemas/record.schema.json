{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ahp-plus:schema:record:1.4.0",
  "title": "AHP+ Governance Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "project_id",
    "title",
    "status",
    "confidence",
    "created_at",
    "updated_at",
    "actor",
    "source_refs",
    "base_commit"
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["name", "platform", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": { "enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0"] },
    "id": { "type": "string", "pattern": "^(DEC|TASK|BUG|RISK|QA|REQ|EVD)-[0-9]{8}-[A-F0-9]{8}$" },
    "kind": { "enum": ["decision", "task", "bug", "risk", "qa", "requirement", "evidence"] },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["VERIFIED", "USER_CONFIRMED", "INFERRED", "UNVERIFIED", "STALE", "CONFLICTED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/actor" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "base_commit": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "evidence_type": { "enum": ["file", "command", "test", "commit", "url", "user_confirmation", "artifact", "screenshot"] },
    "locator": { "type": "string" },
    "result": {},
    "limitations": { "type": "string" },
    "artifact_sha256": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "evidence" } } },
      "then": { "required": ["evidence_type", "locator", "result"] }
    }
  ],
  "additionalProperties": true
}
